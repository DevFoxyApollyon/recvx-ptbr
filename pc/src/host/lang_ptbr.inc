{ "type %c", "tipo %c" },
{ "Also bound to: %s", "Também usado em: %s" },
{ "Swapped with %s", "Trocado com %s" },
{ "Reset gamepad to defaults", "Restaurar controle ao padrão" },
{ "Reset keyboard / mouse to defaults", "Restaurar teclado / mouse ao padrão" },
{ "Also in the game's OPTION menu: ENHANCED SETTINGS -> CONTROLS.", "Também no menu OPTION do jogo: ENHANCED SETTINGS -> CONTROLES." },
{ "THIRD PERSON (KEYBOARD AND MOUSE)", "TERCEIRA PESSOA (TECLADO E MOUSE)" },
{ "THIRD PERSON (GAMEPAD, MODERN)", "TERCEIRA PESSOA (CONTROLE, MODERNO)" },
{ "HOTKEYS", "ATALHOS" },
{ "GAME (KEY CONFIG TYPE %c)", "JOGO (KEY CONFIG TIPO %c)" },
{ "Gamepad bindings reset to the defaults", "Comandos do controle restaurados ao padrão" },
{ "Keyboard bindings reset to the defaults", "Comandos do teclado restaurados ao padrão" },
{ "Done when you leave the menu", "Feito ao sair do menu" },
{ "Not changed", "Não alterado" },
